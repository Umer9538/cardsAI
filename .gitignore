#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Node / Cloudflare
node_modules/
.wrangler/
# Local Worker secrets: service-account key, OpenAI key. Never commit.
.dev.vars

# Firebase service-account keys — full admin access to the project. These
# belong in a Worker secret, never in the repo. Named broadly on purpose:
# the console's download filename varies.
*firebase-adminsdk*.json
*service-account*.json
*serviceaccount*.json

# Real ad unit ids and the worker URL for release builds.
tool/release.env

# Release signing. Losing these means never being able to publish an update to
# an app already on Play under this key — back them up off this machine.
# Release signing. These are the app's identity on Play: a key in the
# repository is a key that has been published. They are also NOT recoverable
# and do NOT travel with a git clone — see android/README-signing.md, which is
# committed and says which files a handover has to carry separately.
android/key.properties
android/SIGNING-CREDENTIALS.md
android/*.jks
android/*.p12
android/*.keystore

# goldie store assets (generated)
#
# Wildcarded over the variant directories — goldie/, goldie-all/, goldie-ipad/
# — because the output is ~140 MB of rendered screenshots that git would carry
# forever, and it is reproducible from the config beside it. The config, the
# refresh script and the flow list ARE committed: those are the source.
goldie*/out/
goldie*/goldie.design.json
goldie-ipad/out/
goldie-ipad/goldie.design.json

# Local tooling scratch
.argent/
*.bak-goldie
