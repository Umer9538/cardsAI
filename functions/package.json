{
  "name": "carbsai-functions",
  "description": "Cloud Functions for Carbsai — the meal analysis pipeline.",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
