    "logs": "firebase functions:log"
  },
  "dependencies": {
    "@types/nodemailer": "^8.0.1",
    "firebase-admin": "^13.0.2",
    "firebase-functions": "^6.3.0",
    "nodemailer": "^9.0.5",
    "openai": "^7.5.0"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  }
}
